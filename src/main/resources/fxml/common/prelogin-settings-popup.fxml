<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="panel"
      spacing="15"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="settings-popup-panel">
    <Label fx:id="lblTitle" styleClass="settings-title"/>
    <Label fx:id="lblLanguage" styleClass="settings-section-label"/>
    <HBox fx:id="languageRow" spacing="12" styleClass="settings-segment-row">
        <Button fx:id="btnEnglish" styleClass="settings-segment-btn"/>
        <Button fx:id="btnVietnamese" styleClass="settings-segment-btn"/>
    </HBox>
    <Label fx:id="lblTheme" styleClass="settings-section-label"/>
    <HBox fx:id="themeRow" spacing="12" styleClass="settings-segment-row">
        <Button fx:id="btnLightTheme" styleClass="settings-segment-btn"/>
        <Button fx:id="btnDarkTheme" styleClass="settings-segment-btn"/>
    </HBox>
    <Label fx:id="lblActions" styleClass="settings-section-label" managed="false" visible="false"/>
    <VBox fx:id="actionsColumn" spacing="12" styleClass="settings-actions-column" managed="false" visible="false">
        <Button fx:id="btnInfo" styleClass="settings-action-btn" maxWidth="1.7976931348623157E308" managed="false" visible="false"/>
        <Button fx:id="btnUpdate" styleClass="settings-action-btn" maxWidth="1.7976931348623157E308" managed="false" visible="false"/>
    </VBox>
</VBox>
