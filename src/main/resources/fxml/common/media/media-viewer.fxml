<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.web.WebView?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.common.modules.media.controllers.MediaViewerController"
      styleClass="media-viewer-root"
      prefWidth="1100" prefHeight="700">
    <!-- Panel detail -->
    <VBox fx:id="leftPanel" styleClass="media-viewer-detail-panel" minWidth="250">
        <!-- Tab bar -->
        <HBox styleClass="media-viewer-tab-bar">
            <Button fx:id="btnTabDetail" onAction="#onTabDetail"
                    styleClass="media-viewer-tab-btn,media-viewer-tab-btn-active"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnTabLocation" onAction="#onTabLocation"
                    styleClass="media-viewer-tab-btn"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Separator/>
        <!-- Detail tab content -->
        <VBox fx:id="detailPane" spacing="10" styleClass="media-viewer-tab-content">
            <VBox spacing="4">
                <Label fx:id="lblDetailNameKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailName" styleClass="media-viewer-detail-value" wrapText="true"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailTypeKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailType" styleClass="media-viewer-detail-value"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailSizeKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailSize" styleClass="media-viewer-detail-value"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailDateKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailDate" styleClass="media-viewer-detail-value"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailDeviceKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailDevice" styleClass="media-viewer-detail-value" wrapText="true"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailUserKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailUser" styleClass="media-viewer-detail-value"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailStatusKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailStatus" styleClass="media-viewer-detail-value"/>
            </VBox>
            <VBox spacing="4">
                <Label fx:id="lblDetailDimensionKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="detailDimension" styleClass="media-viewer-detail-value"/>
            </VBox>
            <Separator/>
            <VBox spacing="6" styleClass="media-viewer-detail-actions">
                <HBox spacing="8" alignment="CENTER_LEFT" minHeight="24">
                    <Label fx:id="detailBookmark" style="-fx-cursor: hand;"/>
                    <Label fx:id="detailBookmarkStatus" styleClass="media-viewer-detail-value" minHeight="24"/>
                </HBox>
                <Label fx:id="detailBookmarkAt" styleClass="media-viewer-detail-bookmark-at" minHeight="24" wrapText="true"/>
                <Button fx:id="btnExport" styleClass="btn-primary" onAction="#onExport"/>
            </VBox>
        </VBox>
        <!-- /detailPane -->
        <!-- Location tab content -->
        <VBox fx:id="locationPane" spacing="10" minHeight="0" VBox.vgrow="ALWAYS"
              styleClass="media-viewer-tab-content"
              visible="false" managed="false">
            <!-- GPS coordinates -->
            <VBox spacing="4">
                <Label fx:id="lblLocationGpsKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="locationGps" styleClass="media-viewer-location-value" wrapText="true"/>
            </VBox>
            <!-- File creation time -->
            <VBox spacing="4">
                <Label fx:id="lblLocationDateKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="locationDate" styleClass="media-viewer-detail-value"/>
            </VBox>
            <!-- Device name -->
            <VBox spacing="4">
                <Label fx:id="lblLocationDeviceKey" styleClass="media-viewer-detail-label"/>
                <Label fx:id="locationDevice" styleClass="media-viewer-detail-value" wrapText="true"/>
            </VBox>
            <Separator/>
            <StackPane minHeight="0" VBox.vgrow="ALWAYS">
                <WebView fx:id="mapView" />
                <StackPane fx:id="mapErrorPane" visible="false" managed="false"
                           minWidth="0" maxHeight="-Infinity" mouseTransparent="true"
                           StackPane.alignment="BOTTOM_CENTER" styleClass="media-viewer-map-error-pane">
                    <StackPane.margin>
                        <Insets bottom="30" left="8" right="8" />
                    </StackPane.margin>
                    <Label fx:id="mapErrorLabel" minWidth="0" wrapText="true"
                           styleClass="media-viewer-map-error-label" />
                </StackPane>
            </StackPane>
        </VBox>
        <!-- /locationPane -->
    </VBox>
    <!-- DRAG HANDLE -->
    <Pane fx:id="dragBar"
          styleClass="drag-bar"
          prefWidth="5"
          minWidth="5"
          maxWidth="5"/>
    <VBox HBox.hgrow="ALWAYS" minWidth="0" minHeight="0">
        <HBox styleClass="media-viewer-toolbar" alignment="CENTER_LEFT" spacing="8">
            <Button fx:id="btnPrev" text="◀" onAction="#onPrev" styleClass="icon-btn-control"/>
            <Button fx:id="btnNext" text="▶" onAction="#onNext" styleClass="icon-btn-control"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnZoomIn" text="＋" onAction="#onZoomIn" styleClass="icon-btn-control"/>
            <Button fx:id="btnZoomOut" text="－" onAction="#onZoomOut" styleClass="icon-btn-control"/>
            <Button fx:id="btnFit" text="⊡" onAction="#onFit" styleClass="icon-btn-control"/>
            <Button fx:id="btnRotateL" text="↺" onAction="#onRotateLeft" styleClass="icon-btn-control"/>
            <Button fx:id="btnRotateR" text="↻" onAction="#onRotateRight" styleClass="icon-btn-control"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCounter" styleClass="media-viewer-counter"/>
        </HBox>
        <StackPane VBox.vgrow="ALWAYS" minWidth="0" minHeight="0" styleClass="media-viewer-content">
            <ScrollPane fx:id="scrollPane" pannable="true"
                        styleClass="media-viewer-scroll" visible="false" managed="false">
                <StackPane fx:id="imageContainer">
                    <ImageView fx:id="imageView" preserveRatio="true"/>
                </StackPane>
            </ScrollPane>
            <VBox fx:id="videoPane" focusTraversable="true" styleClass="media-viewer-content"
                  minWidth="0" minHeight="0" visible="false" managed="false">
                <StackPane fx:id="videoContentPane" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
                    <Pane fx:id="mediaViewWrapper" minWidth="0" minHeight="0"
                          maxWidth="Infinity" maxHeight="Infinity">
                        <ImageView fx:id="videoImageView" preserveRatio="true" smooth="true"/>
                    </Pane>
                    <Label fx:id="lblAudioPlaceholder" text="🎵"
                           visible="false" managed="false" StackPane.alignment="CENTER"/>
                </StackPane>
                <VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" spacing="-14"
                      styleClass="video-controls-overlay">
                    <Slider fx:id="videoSlider" translateY="-17" viewOrder="-1"
                            styleClass="video-slider,video-progress-slider">
                        <VBox.margin>
                            <Insets left="10" right="10"/>
                        </VBox.margin>
                    </Slider>
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="video-controls-bar">
                        <Button text="−30s" minWidth="-Infinity" onAction="#onSeekBack30" styleClass="video-ctrl-btn"/>
                        <Button text="−5s" minWidth="-Infinity" onAction="#onSeekBack5" styleClass="video-ctrl-btn"/>
                        <Button fx:id="btnPlayPause" text="▶" minWidth="35" prefWidth="35" maxWidth="35"
                                onAction="#onPlayPause" styleClass="video-ctrl-btn"/>
                        <Button text="+5s" minWidth="-Infinity" onAction="#onSeekForward5" styleClass="video-ctrl-btn"/>
                        <Button text="+30s" minWidth="-Infinity" onAction="#onSeekForward30" styleClass="video-ctrl-btn"/>
                        <Label fx:id="lblVideoTime" text="00:00 / 00:00" styleClass="media-viewer-meta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cbSpeed" onAction="#onSpeedChanged" styleClass="video-speed-combo"/>
                        <Button fx:id="btnMute" text="🔊" onAction="#onToggleMute"
                                styleClass="video-volume-btn"/>
                        <Slider fx:id="volumeSlider" max="1" value="1" prefWidth="80"
                                styleClass="video-slider"/>
                    </HBox>
                </VBox>
            </VBox>
            <Label fx:id="lblLoading" text="…" styleClass="media-viewer-loading" visible="false" managed="false"/>
            <Label fx:id="lblError" styleClass="media-viewer-error" visible="false" managed="false"/>
        </StackPane>
        <HBox styleClass="media-viewer-statusbar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblFileName" styleClass="media-viewer-filename"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblDimension" styleClass="media-viewer-meta"/>
            <Label fx:id="lblFileSize" styleClass="media-viewer-meta"/>
            <Label fx:id="lblZoom" styleClass="media-viewer-meta"/>
        </HBox>
    </VBox>
</HBox>
