<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Card padding → CSS .login-card { -fx-padding: 15 60 60 60; } -->
<StackPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.app.auth.login.controllers.LoginController"
        styleClass="root">
    <VBox spacing="14" alignment="CENTER" styleClass="login-card">
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnSettings" text="⚙"
                    onAction="#openSettingsPopup" styleClass="icon-btn"/>
        </HBox>
        <Label text="%login.title" styleClass="title"/>
        <VBox spacing="12">
            <!-- ComboBox for recent usernames with editable text -->
            <TextField fx:id="username" editable="true"
                      promptText="%login.username"
                      maxWidth="1.7976931348623157E308"/>
            <StackPane alignment="CENTER_RIGHT">
                <PasswordField fx:id="password"
                               promptText="%login.password" styleClass="input"/>
                <TextField fx:id="passwordVisible"
                           promptText="%login.password" styleClass="input"
                           visible="false" managed="false"/>
                <!-- peek-btn padding → CSS .peek-btn { -fx-padding: 0 8 0 0; } -->
                <Button fx:id="btnPeekPassword" styleClass="peek-btn"/>
            </StackPane>
        </VBox>
        <Label fx:id="message" visible="false" styleClass="message-error"/>
        <Button text="%login.button" onAction="#handleLogin"
                maxWidth="1.7976931348623157E308" styleClass="login-btn"/>
    </VBox>
</StackPane>
