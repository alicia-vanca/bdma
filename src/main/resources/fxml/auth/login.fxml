<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.auth.login.controllers.LoginController"
           styleClass="root"
           alignment="CENTER">
    <VBox spacing="12" alignment="TOP_CENTER" styleClass="login-card" maxHeight="-Infinity">
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnSettings" text="⚙" onAction="#openSettingsPopup" styleClass="icon-btn"/>
        </HBox>
        <Label text="%login.title" styleClass="title"/>
        <VBox spacing="10">
            <TextField fx:id="username" promptText="%login.username" maxWidth="1.7976931348623157E308"/>
            <StackPane>
                <TextField editable="false" mouseTransparent="true" styleClass="input"/>

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: transparent;">
                    <PasswordField fx:id="password" promptText="%login.password"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                    <TextField fx:id="passwordVisible" promptText="%login.password"
                               visible="false" managed="false" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                    <Button fx:id="btnPeekPassword" styleClass="peek-btn"/>
                </HBox>
            </StackPane>
        </VBox>
        <Label fx:id="message" visible="false" styleClass="message-error"/>
        <Button text="%login.button" onAction="#handleLogin" maxWidth="1.7976931348623157E308" styleClass="login-btn"/>
    </VBox>
</StackPane>
