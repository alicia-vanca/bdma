<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="14" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.admin.usermanagement.controllers.UserEditFormController" styleClass="form">
    <Region styleClass="popup-spacer"/>
    <Label fx:id="lblTitle" styleClass="title"/>
    <Region styleClass="popup-header-spacer"/>
    <GridPane hgap="16" vgap="14" maxWidth="1.7976931348623157E308">
        <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="%user.username.label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtUsername" promptText="%user.username" styleClass="input"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="lblUsername" visible="false" managed="false" styleClass="account-readonly-value"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%user.role.label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbRole" maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="lblRole" visible="false" managed="false" styleClass="account-readonly-value"
               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="lblPasswordCaption" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <StackPane GridPane.rowIndex="2" GridPane.columnIndex="1">
            <TextField editable="false" mouseTransparent="true" styleClass="input"/>
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: transparent;">
                <PasswordField fx:id="txtPassword" promptText="%user.password.hint"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                <TextField fx:id="txtPasswordVisible" promptText="%user.password.hint"
                           visible="false" managed="false" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                <Button fx:id="btnPeekPassword" styleClass="peek-btn"/>
            </HBox>
        </StackPane>
        <Label fx:id="lblPasswordConfirmCaption" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <StackPane GridPane.rowIndex="3" GridPane.columnIndex="1">
            <TextField editable="false" mouseTransparent="true" styleClass="input"/>
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: transparent;">
                <PasswordField fx:id="txtPasswordConfirm" promptText="%user.password.confirm.hint"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                <TextField fx:id="txtPasswordConfirmVisible" promptText="%user.password.confirm.hint"
                           visible="false" managed="false" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
                <Button fx:id="btnPeekPasswordConfirm" styleClass="peek-btn"/>
            </HBox>
        </StackPane>
    </GridPane>
    <Label fx:id="lblError" visible="false" styleClass="message-error"/>
    <HBox spacing="12" alignment="CENTER">
        <Button text="%common.cancel" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button text="%common.save" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>
    <Region styleClass="popup-spacer"/>
</VBox>
