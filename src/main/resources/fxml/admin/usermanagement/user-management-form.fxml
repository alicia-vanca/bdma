<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- prefWidth removed: set by stage.setMinWidth() in controller -->
<!-- popup-spacer size → CSS base.css .popup-spacer { -fx-pref-height: 23; } -->
<VBox spacing="14" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.admin.usermanagement.controllers.UserEditFormController"
      styleClass="form">
       <Region styleClass="popup-spacer"/>
       <Label fx:id="lblTitle" styleClass="title"/>
       <Region styleClass="popup-header-spacer"/>
       <GridPane hgap="16" vgap="14" maxWidth="1.7976931348623157E308">
              <columnConstraints>
                     <ColumnConstraints minWidth="150"/>
                     <ColumnConstraints hgrow="ALWAYS"/>
              </columnConstraints>
              <!-- Row 0: Username -->
              <Label text="%user.username.label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
              <TextField fx:id="txtUsername" promptText="%user.username"
                         styleClass="input"
                         GridPane.rowIndex="0" GridPane.columnIndex="1"/>
              <Label fx:id="lblUsername" visible="false" managed="false"
                     styleClass="account-readonly-value"
                     GridPane.rowIndex="0" GridPane.columnIndex="1"/>
              <!-- Row 1: Role -->
              <Label text="%user.role.label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
              <ComboBox fx:id="cbRole" maxWidth="1.7976931348623157E308"
                        GridPane.rowIndex="1" GridPane.columnIndex="1"/>
              <Label fx:id="lblRole" visible="false" managed="false"
                     styleClass="account-readonly-value"
                     GridPane.rowIndex="1" GridPane.columnIndex="1"/>
              <!-- Row 2: Password -->
              <Label fx:id="lblPasswordCaption"
                     GridPane.rowIndex="2" GridPane.columnIndex="0"/>
              <StackPane alignment="CENTER_RIGHT"
                         GridPane.rowIndex="2" GridPane.columnIndex="1">
                     <PasswordField fx:id="txtPassword" promptText="%user.password.hint" styleClass="input"/>
                     <TextField    fx:id="txtPasswordVisible" promptText="%user.password.hint"
                                   styleClass="input" visible="false" managed="false"/>
                     <!-- peek-btn padding → CSS .peek-btn { -fx-padding: 0 8 0 0; } -->
                     <Button fx:id="btnPeekPassword" styleClass="peek-btn"/>
              </StackPane>
              <!-- Row 3: Confirm Password -->
              <Label fx:id="lblPasswordConfirmCaption"
                     GridPane.rowIndex="3" GridPane.columnIndex="0"/>
              <StackPane alignment="CENTER_RIGHT"
                         GridPane.rowIndex="3" GridPane.columnIndex="1">
                     <PasswordField fx:id="txtPasswordConfirm" promptText="%user.password.confirm.hint" styleClass="input"/>
                     <TextField    fx:id="txtPasswordConfirmVisible" promptText="%user.password.confirm.hint"
                                   styleClass="input" visible="false" managed="false"/>
                     <Button fx:id="btnPeekPasswordConfirm" styleClass="peek-btn"/>
              </StackPane>
       </GridPane>
       <Label fx:id="lblError" visible="false" styleClass="message-error"/>
       <HBox spacing="12" alignment="CENTER_RIGHT">
              <Button text="%common.cancel" onAction="#onCancel" styleClass="btn-secondary"/>
              <Button text="%common.save"   onAction="#onSave"   styleClass="btn-primary"/>
       </HBox>
       <Region styleClass="popup-spacer"/>
</VBox>
