<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.usermanagement.controllers.UserManagementController"
           styleClass="content">
    <VBox spacing="12">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-bar">
            <TextField fx:id="txtSearch" promptText="%user.search"
                       styleClass="input" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cbRole" promptText="%filter.allRoles"/>
            <ComboBox fx:id="cbStatus" promptText="%filter.allStatus"/>
            <Button text="%filter.reset"  onAction="#onReset" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%user.add" onAction="#onAdd" styleClass="btn-primary"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" fixedCellSize="40">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colSTT" text="%common.stt" minWidth="10" maxWidth="90" sortable="false"/>
                <TableColumn fx:id="colUsername" text="%user.username" prefWidth="30"/>
                <TableColumn fx:id="colRole" text="%user.role" prefWidth="20"/>
                <TableColumn fx:id="colStatus" text="%user.status" prefWidth="15" sortable="false"/>
                <TableColumn fx:id="colAction" text="%common.action" prefWidth="40" sortable="false"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pagination-bar">
            <Label text="%common.show"/>
            <ComboBox fx:id="cbPageSize" styleClass="page-size-combo"/>
            <Label text="%common.per.page"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnFirst" text="«" onAction="#onFirstPage" styleClass="btn-secondary"/>
            <Button fx:id="btnPrev" text="‹" onAction="#onPrevPage" styleClass="btn-secondary"/>
            <HBox fx:id="pageButtonsBox" spacing="4" alignment="CENTER"/>
            <Button fx:id="btnNext" text="›" onAction="#onNextPage" styleClass="btn-secondary"/>
            <Button fx:id="btnLast" text="»" onAction="#onLastPage" styleClass="btn-secondary"/>
            <TextField fx:id="txtPageNumber" styleClass="page-number-input" promptText="1"/>
            <Label fx:id="lblPageTotal" styleClass="page-total-label"/>
        </HBox>
    </VBox>
</StackPane>
