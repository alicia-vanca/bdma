<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.admin.layout.controllers.DashboardController"
      styleClass="content">

    <VBox styleClass="device-panel" minWidth="220" maxWidth="220">
        <padding><Insets top="12" right="8" bottom="12" left="12"/></padding>
        <Label text="%dashboard.devices" styleClass="panel-title"/>
        <ListView fx:id="deviceListView" VBox.vgrow="ALWAYS"/>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <VBox spacing="12" HBox.hgrow="ALWAYS" alignment="TOP_LEFT">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <Label text="%menu.dashboard" styleClass="title"/>
        <Label text="%dashboard.welcome"/>
    </VBox>

</HBox>