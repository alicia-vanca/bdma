<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<!-- device-panel width → CSS .device-panel / .file-list-pane -->
<HBox
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.app.admin.layout.controllers.DashboardController"
        styleClass="content">
    <VBox styleClass="device-panel">
        <Label text="%dashboard.devices" styleClass="panel-title"/>
        <ListView fx:id="deviceListView" VBox.vgrow="ALWAYS"/>
    </VBox>
    <Separator orientation="VERTICAL"/>
    <VBox spacing="16" HBox.hgrow="ALWAYS" alignment="TOP_LEFT" styleClass="file-list-pane">
        <padding>
            <Insets top="0" right="0" bottom="0" left="18"/>
        </padding>
        <HBox alignment="TOP_LEFT" spacing="10" prefHeight="34" minHeight="34" maxHeight="34">
            <Label text="%menu.dashboard" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%queue.dialog.title" onAction="#openQueueDialog" styleClass="btn-primary"/>
        </HBox>
        <Label text="%menu.dashboard" styleClass="title"/>
        <StackPane fx:id="fileListContainer" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
