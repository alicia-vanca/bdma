<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.settingsdialog.controllers.AdminSettingsDialogController"
           stylesheets="@/css/admin.css"
           styleClass="form,dialog-container,settings-dialog-container">
    <VBox fx:id="panel"
      spacing="10"
      alignment="CENTER"
      prefWidth="720"
      minWidth="720"
      prefHeight="800">
        <Region styleClass="popup-spacer"/>
        <Label fx:id="lblTitle" styleClass="title"/>
        <Region styleClass="popup-header-spacer"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="settings-dialog-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="16" fillWidth="true" styleClass="settings-dialog-body">
                    <GridPane styleClass="settings-split-layout">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <VBox spacing="14" styleClass="settings-split-left" GridPane.columnIndex="0">
                            <HBox spacing="0" alignment="CENTER_LEFT" styleClass="settings-inline-row">
                                <Label fx:id="lblLanguage" styleClass="settings-section-label settings-inline-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox fx:id="languageRow" spacing="8" styleClass="settings-segment-row settings-button-row-fixed">
                                    <Button fx:id="btnEnglish" styleClass="settings-segment-btn"/>
                                    <Button fx:id="btnVietnamese" styleClass="settings-segment-btn"/>
                                </HBox>
                            </HBox>
                            <HBox spacing="0" alignment="CENTER_LEFT" styleClass="settings-inline-row">
                                <Label fx:id="lblTheme" styleClass="settings-section-label settings-inline-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox fx:id="themeRow" spacing="8" styleClass="settings-segment-row settings-button-row-fixed">
                                    <Button fx:id="btnLightTheme" styleClass="settings-segment-btn"/>
                                    <Button fx:id="btnDarkTheme" styleClass="settings-segment-btn"/>
                                </HBox>
                            </HBox>
                        </VBox>
                        <VBox fx:id="actionsColumn" spacing="14" styleClass="settings-actions-column settings-split-right" GridPane.columnIndex="1" GridPane.valignment="TOP">
                            <padding>
                                <Insets top="0" right="1" bottom="0" left="16"/>
                            </padding>
                            <Button fx:id="btnInfo" maxWidth="1.7976931348623157E308" styleClass="settings-action-btn"/>
                            <Button fx:id="btnUpdate" maxWidth="1.7976931348623157E308" styleClass="settings-action-btn"/>
                        </VBox>
                    </GridPane>
                    <VBox fx:id="adminSections" spacing="8" fillWidth="true">
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-card">
                            <Label fx:id="lblSaveFolderTitle" styleClass="section-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="settings-form-row">
                                <TextField fx:id="txtSavePath"
                                           editable="false"
                                           styleClass="input"
                                           HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnChooseSaveFolder"
                                        onAction="#onSelectSaveFolder"
                                        styleClass="btn-secondary"/>
                            </HBox>
                            <Label fx:id="lblSaveFolderNote" wrapText="true" styleClass="settings-note"/>
                            <Region prefHeight="8"/>
                            <Label fx:id="lblBackupFolderTitle" styleClass="section-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="settings-form-row">
                                <TextField fx:id="txtBackupPath"
                                           editable="false"
                                           styleClass="input"
                                           HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnChooseBackupFolder"
                                        onAction="#onSelectBackupFolder"
                                        styleClass="btn-secondary"/>
                            </HBox>
                            <Label fx:id="lblDriveConflictWarning" wrapText="true" styleClass="settings-warning" managed="false" visible="false"/>
                        </VBox>
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-card">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="btnRestore"
                                        onAction="#onRestore"
                                        styleClass="btn-secondary"
                                        HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <HBox fx:id="storageActionBox"
                                  spacing="8"
                                  alignment="CENTER_LEFT"
                                  managed="false"
                                  visible="false">
                                <Label fx:id="lblStorageProgress"
                                       wrapText="true"
                                       styleClass="settings-note"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnRetryFailedRestore"
                                        onAction="#onRetryFailedRestore"
                                        styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-card">
                            <Label fx:id="lblAutoDeleteTitle" styleClass="section-label"/>
                            <Label fx:id="lblAutoDeleteDescription" wrapText="true"/>
                            <CheckBox fx:id="chkAutoDelete" onAction="#onToggleAutoDelete"/>
                            <Label fx:id="lblAutoDeleteNote" wrapText="true" styleClass="settings-note"/>
                        </VBox>
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-card">
                            <Label fx:id="lblStartWithWindowsTitle" styleClass="section-label"/>
                            <Label fx:id="lblStartWithWindowsDescription" wrapText="true"/>
                            <CheckBox fx:id="chkStartWithWindows" onAction="#onToggleStartWithWindows"/>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
            <VBox.margin>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </VBox.margin>
        </ScrollPane>
        <Region styleClass="popup-spacer"/>
    </VBox>
    <VBox fx:id="noticeContainer"
          spacing="8"
          alignment="BOTTOM_CENTER"
          fillWidth="false"
          mouseTransparent="true"
          StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets top="0" right="0" bottom="24" left="0"/>
        </StackPane.margin>
    </VBox>
</StackPane>
