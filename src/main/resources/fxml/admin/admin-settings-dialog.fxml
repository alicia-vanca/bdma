<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- prefWidth/prefHeight removed; set by stage in controller -->
<!-- All inline Insets removed; padding in CSS -->
<StackPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.app.admin.settingsdialog.controllers.AdminSettingsDialogController"
        styleClass="form,dialog-container,settings-dialog-container">
    <VBox fx:id="panel" spacing="10" alignment="CENTER">
        <Region styleClass="popup-spacer"/>
        <Label fx:id="lblTitle" styleClass="settings-title"/>
        <Region styleClass="popup-header-spacer"/>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="settings-dialog-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14" fillWidth="true">
                    <!-- Language + Theme + Actions: split layout -->
                    <GridPane styleClass="settings-split-layout">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <!-- Left: language + theme segments -->
                        <VBox spacing="12" styleClass="settings-split-left" GridPane.columnIndex="0">
                            <HBox alignment="CENTER_LEFT" styleClass="settings-inline-row">
                                <Label fx:id="lblLanguage"
                                       styleClass="settings-section-label settings-inline-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox spacing="8" styleClass="settings-segment-row settings-button-row-fixed">
                                    <Button fx:id="btnEnglish"    styleClass="settings-segment-btn"/>
                                    <Button fx:id="btnVietnamese" styleClass="settings-segment-btn"/>
                                </HBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="settings-inline-row">
                                <Label fx:id="lblTheme"
                                       styleClass="settings-section-label settings-inline-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox spacing="8" styleClass="settings-segment-row settings-button-row-fixed">
                                    <Button fx:id="btnLightTheme" styleClass="settings-segment-btn"/>
                                    <Button fx:id="btnDarkTheme"  styleClass="settings-segment-btn"/>
                                </HBox>
                            </HBox>
                        </VBox>
                        <!-- Right: info + update actions -->
                        <!-- padding → CSS .settings-split-right { -fx-padding: 0 0 0 16; } -->
                        <VBox spacing="12" styleClass="settings-actions-column settings-split-right"
                              GridPane.columnIndex="1" GridPane.valignment="TOP">
                            <Button fx:id="btnInfo"   maxWidth="1.7976931348623157E308" styleClass="settings-action-btn"/>
                            <Button fx:id="btnUpdate" maxWidth="1.7976931348623157E308" styleClass="settings-action-btn"/>
                        </VBox>
                    </GridPane>
                    <Separator styleClass="settings-inner-separator"/>
                    <!-- Storage folders -->
                    <VBox spacing="8" styleClass="settings-card">
                        <Label fx:id="lblSaveFolderTitle" styleClass="settings-section-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="settings-form-row">
                            <TextField fx:id="txtSavePath" editable="false"
                                       styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnChooseSaveFolder"
                                    onAction="#onSelectSaveFolder" styleClass="btn-secondary"/>
                        </HBox>
                        <Label fx:id="lblSaveFolderNote" wrapText="true" styleClass="settings-note"/>
                        <Label fx:id="lblBackupFolderTitle" styleClass="settings-section-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="settings-form-row">
                            <TextField fx:id="txtBackupPath" editable="false"
                                       styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnChooseBackupFolder"
                                    onAction="#onSelectBackupFolder" styleClass="btn-secondary"/>
                        </HBox>
                        <Label fx:id="lblDriveConflictWarning" wrapText="true"
                               styleClass="settings-warning" managed="false" visible="false"/>
                    </VBox>
                    <Separator styleClass="settings-inner-separator"/>
                    <!-- Restore -->
                    <VBox spacing="8" styleClass="settings-card">
                        <Button fx:id="btnRestore" onAction="#onRestore"
                                maxWidth="1.7976931348623157E308" styleClass="btn-secondary"/>
                        <HBox fx:id="storageActionBox" spacing="8" alignment="CENTER_LEFT"
                              managed="false" visible="false">
                            <Label fx:id="lblStorageProgress" wrapText="true"
                                   styleClass="settings-note" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRetryFailedRestore"
                                    onAction="#onRetryFailedRestore"
                                    managed="false" visible="false"
                                    styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                    <Separator styleClass="settings-inner-separator"/>
                    <!-- Auto-delete -->
                    <VBox spacing="8" styleClass="settings-card">
                        <Label fx:id="lblAutoDeleteTitle" styleClass="settings-section-label"/>
                        <Label fx:id="lblAutoDeleteDescription" wrapText="true"/>
                        <CheckBox fx:id="chkAutoDelete" onAction="#onToggleAutoDelete"/>
                        <Label fx:id="lblAutoDeleteNote" wrapText="true" styleClass="settings-note"/>
                    </VBox>
                    <Separator styleClass="settings-inner-separator"/>
                    <!-- Start with Windows -->
                    <VBox spacing="8" styleClass="settings-card">
                        <Label fx:id="lblStartWithWindowsTitle" styleClass="settings-section-label"/>
                        <Label fx:id="lblStartWithWindowsDescription" wrapText="true"/>
                        <CheckBox fx:id="chkStartWithWindows" onAction="#onToggleStartWithWindows"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
        <Region styleClass="popup-spacer"/>
    </VBox>
    <!-- Notice overlay: bottom padding → CSS .notice-container-dialog -->
    <VBox fx:id="noticeContainer" spacing="8" alignment="BOTTOM_CENTER"
          fillWidth="false" mouseTransparent="true"
          styleClass="notice-container-dialog"
          StackPane.alignment="BOTTOM_CENTER"/>
</StackPane>
