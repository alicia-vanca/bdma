<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.app.admin.settingsdialog.controllers.AdminSettingsDialogController"
        styleClass="form,dialog-container,settings-dialog-container">
    <VBox fx:id="panel" styleClass="settings-dialog-body">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="settings-dialog-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="0" fillWidth="true">
                    <GridPane styleClass="settings-top-grid">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <GridPane styleClass="settings-split-left" GridPane.columnIndex="0"
                                  hgap="10" vgap="10" maxWidth="1.7976931348623157E308"
                                  GridPane.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label fx:id="lblLanguage" styleClass="settings-section-label"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                            <Button fx:id="btnEnglish" styleClass="settings-segment-btn"
                                    maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                    GridPane.hgrow="ALWAYS"/>
                            <Button fx:id="btnVietnamese" styleClass="settings-segment-btn"
                                    maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="2"
                                    GridPane.hgrow="ALWAYS"/>

                            <Label fx:id="lblTheme" styleClass="settings-section-label"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                            <Button fx:id="btnLightTheme" styleClass="settings-segment-btn"
                                    maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                    GridPane.hgrow="ALWAYS"/>
                            <Button fx:id="btnDarkTheme" styleClass="settings-segment-btn"
                                    maxWidth="1.7976931348623157E308" GridPane.rowIndex="1" GridPane.columnIndex="2"
                                    GridPane.hgrow="ALWAYS"/>
                        </GridPane>
                        <VBox spacing="8" styleClass="settings-split-right" GridPane.columnIndex="1"
                              GridPane.valignment="CENTER">
                            <Button fx:id="btnInfo" maxWidth="1.7976931348623157E308" styleClass="settings-action-btn"/>
                            <Button fx:id="btnUpdate" maxWidth="1.7976931348623157E308"
                                    styleClass="settings-action-btn"/>
                        </VBox>
                    </GridPane>
                    <Separator styleClass="settings-sep"/>
                    <VBox spacing="6" styleClass="settings-card">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="lblSaveFolderTitle" styleClass="settings-field-label"/>
                            <TextField fx:id="txtSavePath" editable="false" styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnChooseSaveFolder" onAction="#onSelectSaveFolder"
                                    styleClass="btn-secondary"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="lblBackupFolderTitle" styleClass="settings-field-label"/>
                            <TextField fx:id="txtBackupPath" editable="false" styleClass="input" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnChooseBackupFolder" onAction="#onSelectBackupFolder"
                                    styleClass="btn-secondary"/>
                        </HBox>
                        <Label fx:id="lblSaveFolderNote" wrapText="true" styleClass="settings-note"/>
                        <Label fx:id="lblDriveConflictWarning" wrapText="true" styleClass="settings-warning"
                               managed="false" visible="false"/>
                    </VBox>
                    <Separator styleClass="settings-sep"/>
                    <VBox spacing="6" styleClass="settings-card">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button fx:id="btnRestore" onAction="#onRestore" styleClass="btn-secondary"/>
                            <Label fx:id="lblStorageProgress" wrapText="true" styleClass="settings-note"
                                   HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRetryFailedRestore" onAction="#onRetryFailedRestore"
                                    managed="false" visible="false" styleClass="btn-secondary"/>
                        </HBox>
                        <HBox fx:id="storageActionBox" managed="false" visible="false"/>
                    </VBox>
                    <Separator styleClass="settings-sep"/>
                    <VBox spacing="4" styleClass="settings-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="chkAutoDelete" onAction="#onToggleAutoDelete"/>
                        </HBox>
                        <Label fx:id="lblAutoDeleteDescription" wrapText="true" styleClass="settings-note"/>
                    </VBox>
                    <Separator styleClass="settings-sep"/>
                    <VBox spacing="4" styleClass="settings-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <CheckBox fx:id="chkStartWithWindows" onAction="#onToggleStartWithWindows"/>
                        </HBox>
                        <Label fx:id="lblStartWithWindowsDescription" wrapText="true" styleClass="settings-note"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
    <VBox fx:id="noticeContainer" spacing="8" alignment="BOTTOM_CENTER" fillWidth="false" mouseTransparent="true"
          styleClass="notice-container-dialog" StackPane.alignment="BOTTOM_CENTER"/>
</StackPane>
