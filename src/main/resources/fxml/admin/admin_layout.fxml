<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.layout.controllers.AdminLayoutController"
           styleClass="root">
    <BorderPane>
        <top>
            <VBox styleClass="header-shell" spacing="6">
                <padding>
                    <Insets top="8" right="23" bottom="8" left="23"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
                    <Label text="BDMA" styleClass="header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="top-right-actions">
                        <Label fx:id="labelGreeting" styleClass="greeting-label"/>
                        <Button fx:id="btnSettings"
                                text="⚙"
                                onAction="#openSettingsPopup"
                                styleClass="icon-btn"/>
                        <Button fx:id="btnLogout"
                                text="%top.logout"
                                onAction="#logout"
                                styleClass="btn-logout"/>
                    </HBox>
                </HBox>
                <HBox spacing="15" styleClass="tabs-row">
                    <Button text="%menu.dashboard"
                            fx:id="btnDashboard"
                            onAction="#goDashboard"
                            styleClass="menu-tab-btn"/>
                    <Button text="%menu.user"
                            fx:id="btnUser"
                            onAction="#goUser"
                            styleClass="menu-tab-btn"/>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane>
                <BorderPane>
                    <center>
                        <StackPane fx:id="contentArea" styleClass="content-shell" VBox.vgrow="ALWAYS"/>
                    </center>
                </BorderPane>
                <VBox fx:id="noticeContainer"
                      spacing="11"
                      alignment="BOTTOM_CENTER"
                      fillWidth="false"
                      mouseTransparent="true">
                    <StackPane.margin>
                        <Insets right="0" bottom="30" left="0"/>
                    </StackPane.margin>
                </VBox>
            </StackPane>
        </center>
        <bottom>
            <VBox fx:id="statusBar" styleClass="status-bar" spacing="0">
                <!-- Warning strip: shown when storage is critical -->
                <HBox fx:id="warningStrip"
                      alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="status-warning-strip"
                      managed="false"
                      visible="false">
                    <padding>
                        <Insets top="4" right="16" bottom="4" left="16"/>
                    </padding>
                    <Label text="⚠" styleClass="status-warning-icon"/>
                    <Label fx:id="lblStatusWarning"
                           wrapText="false"
                           styleClass="status-warning-label"
                           HBox.hgrow="ALWAYS"/>
                </HBox>
                <!-- Storage panels row -->
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="status-storage-row">
                    <padding>
                        <Insets top="4" right="16" bottom="4" left="16"/>
                    </padding>
                    <!-- Data storage panel -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="storage-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblDataStorageTitle" styleClass="storage-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDataStorageUsage" styleClass="storage-detail"/>
                            <Label fx:id="lblDataStoragePercent" styleClass="storage-percent"/>
                        </HBox>
                        <ProgressBar fx:id="pbDataStorage"
                                     progress="0"
                                     styleClass="storage-progress"
                                     maxWidth="1.7976931348623157E308"/>

                    </VBox>
                    <Separator orientation="VERTICAL" styleClass="storage-separator">
                        <HBox.margin>
                            <Insets left="16" right="16"/>
                        </HBox.margin>
                    </Separator>
                    <!-- Backup storage panel -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="storage-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblBackupStorageTitle" styleClass="storage-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblBackupStorageUsage" styleClass="storage-detail"/>
                            <Label fx:id="lblBackupStoragePercent" styleClass="storage-percent"/>
                        </HBox>
                        <ProgressBar fx:id="pbBackupStorage"
                                     progress="0"
                                     styleClass="storage-progress"
                                     maxWidth="1.7976931348623157E308"/>
                    </VBox>
                </HBox>
                <!-- Drive conflict warning -->
                <HBox managed="false" visible="false"
                      fx:id="driveConflictRow">
                    <padding>
                        <Insets top="0" right="20" bottom="5" left="20"/>
                    </padding>
                    <Label fx:id="lblDriveConflictWarning" wrapText="true"
                           styleClass="settings-warning"/>
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>
