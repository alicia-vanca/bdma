<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.controller.AdminLayoutController"
           styleClass="root">
    <BorderPane>
        <top>
            <VBox styleClass="header-shell" spacing="8">
                <padding>
                    <Insets top="10" right="15" bottom="10" left="15"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
                    <Label text="BDMA" styleClass="header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="top-right-actions">
                        <Label fx:id="labelGreeting" styleClass="greeting-label"/>
                        <Button fx:id="btnSettings"
                                text="⚙"
                                onAction="#openSettingsPopup"
                                styleClass="icon-btn"/>
                        <Button fx:id="btnLogout"
                                text="%top.logout"
                                onAction="#logout"
                                styleClass="btn-logout"/>
                    </HBox>
                </HBox>
                <HBox spacing="10" styleClass="tabs-row">
                    <Button text="%menu.dashboard"
                            fx:id="btnDashboard"
                            onAction="#goDashboard"
                            styleClass="menu-tab-btn"/>
                    <Button text="%menu.user"
                            fx:id="btnUser"
                            onAction="#goUser"
                            styleClass="menu-tab-btn"/>
                    <Button text="%settings.title"
                            fx:id="btnAppSetting"
                            onAction="#toggleAppSettingMenu"
                            styleClass="menu-tab-btn"/>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane fx:id="contentArea" styleClass="content-shell"/>
        </center>
    </BorderPane>
    <VBox fx:id="appSettingMenu"
          managed="false"
          mouseTransparent="true"
          visible="false"
          fillWidth="true"
          styleClass="dropdown-menu">
        <Button fx:id="btnStorageSetting"
                text="%settings.storage"
                onAction="#goStorageSetting"
                maxWidth="Infinity"
                styleClass="dropdown-item"/>
        <Button fx:id="btnDataBackupSetting"
                text="%settings.data_backup"
                onAction="#goDataBackupSetting"
                maxWidth="Infinity"
                styleClass="dropdown-item"/>
    </VBox>
    <VBox fx:id="noticeContainer"
          spacing="8"
          alignment="BOTTOM_CENTER"
          fillWidth="false"
          mouseTransparent="true"
          StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets top="0" right="0" bottom="40" left="0"/>
        </StackPane.margin>
    </VBox>
</StackPane>
