<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.layout.controllers.AdminLayoutController"
           styleClass="root">
    <BorderPane>
        <top>
            <VBox styleClass="header-shell" spacing="8">
                <padding>
                    <Insets top="10" right="15" bottom="10" left="15"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
                    <Label text="BDMA" styleClass="header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="top-right-actions">
                        <Label fx:id="labelGreeting" styleClass="greeting-label"/>
                        <Button fx:id="btnSettings"
                                text="⚙"
                                onAction="#openSettingsPopup"
                                styleClass="icon-btn"/>
                        <Button fx:id="btnLogout"
                                text="%top.logout"
                                onAction="#logout"
                                styleClass="btn-logout"/>
                    </HBox>
                </HBox>
                <HBox spacing="10" styleClass="tabs-row">
                    <Button text="%menu.dashboard"
                            fx:id="btnDashboard"
                            onAction="#goDashboard"
                            styleClass="menu-tab-btn"/>
                    <Button text="%menu.user"
                            fx:id="btnUser"
                            onAction="#goUser"
                            styleClass="menu-tab-btn"/>
                </HBox>
            </VBox>
        </top>
        <center>
            <StackPane fx:id="contentArea" styleClass="content-shell"/>
        </center>
        <bottom>
            <VBox fx:id="statusBar" styleClass="status-bar" spacing="0">

                <HBox fx:id="warningStrip"
                      alignment="CENTER_LEFT"
                      spacing="8"
                      styleClass="status-warning-strip"
                      managed="false"
                      visible="false">
                    <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
                    <Label text="⚠" styleClass="status-warning-icon"/>
                    <Label fx:id="lblStatusWarning"
                           wrapText="false"
                           styleClass="status-warning-label"
                           HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="status-storage-row">
                    <padding><Insets top="5" right="12" bottom="5" left="12"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%status.dataFolder" styleClass="status-storage-name"/>
                        <ProgressBar fx:id="pbDataStorage"
                                     progress="0"
                                     styleClass="storage-progress"
                                     prefWidth="140"
                                     HBox.hgrow="ALWAYS"
                                     maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblDataStorageUsage" styleClass="status-storage-usage"/>
                    </HBox>

                    <Separator orientation="VERTICAL"/>

                    <HBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%status.backupFolder" styleClass="status-storage-name"/>
                        <ProgressBar fx:id="pbBackupStorage"
                                     progress="0"
                                     styleClass="storage-progress"
                                     prefWidth="140"
                                     HBox.hgrow="ALWAYS"
                                     maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblBackupStorageUsage" styleClass="status-storage-usage"/>
                    </HBox>
                </HBox>
                <HBox>
                    <Label fx:id="lblDriveConflictWarning" wrapText="true" styleClass="settings-warning" managed="false" visible="false"/>
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>
    <VBox fx:id="noticeContainer"
          spacing="8"
          alignment="BOTTOM_CENTER"
          fillWidth="false"
          mouseTransparent="true"
          StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets top="0" right="0" bottom="40" left="0"/>
        </StackPane.margin>
    </VBox>
</StackPane>
