<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="root"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.admin.devicemanagement.controllers.DeviceManagementController"
           styleClass="content">
    <VBox spacing="12">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-bar">
            <TextField fx:id="txtSearch" promptText="%device.management.search"
                       styleClass="input" minWidth="220" prefWidth="280" maxWidth="340"/>
            <ComboBox fx:id="cbStatus" promptText="%filter.allStatus"/>
            <Button text="%filter.reset" onAction="#onReset" styleClass="btn-secondary"/>
            <Button text="%common.refresh" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" fixedCellSize="40" styleClass="table-view">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colSTT" text="%common.stt" minWidth="10" maxWidth="90" sortable="false"/>
                <TableColumn fx:id="colDeviceName" text="%device.management.name" prefWidth="35"/>
                <TableColumn fx:id="colCameraId" text="%device.management.cameraId" prefWidth="35"/>
                <TableColumn fx:id="colStatus" text="%device.management.status" prefWidth="20"/>
                <TableColumn fx:id="colLastSync" text="%device.management.lastSync" prefWidth="30"/>
                <TableColumn fx:id="colAction" text="%common.action" prefWidth="45" sortable="false"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pagination-bar">
            <Label text="%common.show"/>
            <ComboBox fx:id="cbPageSize" styleClass="page-size-combo"/>
            <Label text="%common.per.page"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnFirst" text="«" onAction="#onFirstPage" styleClass="btn-secondary,btn-pagination"/>
            <Button fx:id="btnPrev" text="‹" onAction="#onPrevPage" styleClass="btn-secondary,btn-pagination"/>
            <HBox fx:id="pageButtonsBox" spacing="4" alignment="CENTER"/>
            <Button fx:id="btnNext" text="›" onAction="#onNextPage" styleClass="btn-secondary,btn-pagination"/>
            <Button fx:id="btnLast" text="»" onAction="#onLastPage" styleClass="btn-secondary,btn-pagination"/>
            <TextField fx:id="txtPageNumber" styleClass="page-number-input" promptText="1"/>
            <Label fx:id="lblPageTotal" styleClass="page-total-label"/>
        </HBox>
    </VBox>
</StackPane>
