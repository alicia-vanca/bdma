<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<StackPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.guest.controllers.GuestLayoutController" styleClass="root">
<BorderPane minWidth="800">
    <top>
        <VBox styleClass="header-shell" spacing="6" >
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
                <Label>
                    <graphic>
                        <ImageView fx:id="nteIcon"/>
                    </graphic>
                </Label>
                <HBox spacing="15" styleClass="tabs-row">
                    <HBox.margin>
                        <Insets left="30"/>
                    </HBox.margin>
                    <Button fx:id="btnDashboard" text="%menu.dashboard" onAction="#goLogin"
                            styleClass="menu-tab-btn"/>
                    <Button fx:id="btnUser" text="%menu.user" onAction="#goLogin" styleClass="menu-tab-btn"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="top-right-actions">
                    <Label fx:id="labelGreeting" styleClass="greeting-label"/>
                    <Button fx:id="btnSettings" text="⚙" onAction="#openSettingsPopup" styleClass="icon-btn"/>
                    <Button text="%top.login" onAction="#goLogin" styleClass="btn-login"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane>
            <StackPane fx:id="contentArea" styleClass="content-shell" VBox.vgrow="ALWAYS"/>
            <VBox fx:id="noticeContainer" spacing="11" alignment="BOTTOM_CENTER" fillWidth="false"
                  mouseTransparent="true" styleClass="notice-container"/>
        </StackPane>
    </center>
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" styleClass="status-storage-row"
                  prefWidth="350" minWidth="300">
                <HBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS" minWidth="120">
                    <Label fx:id="lblDataStorageTitle" styleClass="storage-title"/>
                    <StackPane HBox.hgrow="ALWAYS" maxWidth="160" minWidth="40">
                        <ProgressBar fx:id="pbDataStorage" progress="0" styleClass="storage-progress"
                                     maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblDataStoragePercent" styleClass="storage-percent" mouseTransparent="true"/>
                    </StackPane>
                    <Label fx:id="lblDataStorageUsage" styleClass="storage-detail"/>
                </HBox>
                <Separator orientation="VERTICAL" styleClass="storage-separator"/>
                <HBox alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS" minWidth="120">
                    <Label fx:id="lblBackupStorageTitle" styleClass="storage-title"/>
                    <StackPane HBox.hgrow="ALWAYS" maxWidth="160" minWidth="40">
                        <ProgressBar fx:id="pbBackupStorage" progress="0" styleClass="storage-progress"
                                     maxWidth="1.7976931348623157E308"/>
                        <Label fx:id="lblBackupStoragePercent" styleClass="storage-percent"
                               mouseTransparent="true"/>
                    </StackPane>
                    <Label fx:id="lblBackupStorageUsage" styleClass="storage-detail"/>
                </HBox>
            </HBox>
            <HBox fx:id="warningStrip" alignment="CENTER_LEFT" spacing="8"
                  styleClass="status-warning-strip" HBox.hgrow="ALWAYS" prefWidth="450">
                <Label fx:id="lblCombinedWarning" wrapText="false" minWidth="0"
                       styleClass="status-warning-label" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>
</StackPane>
